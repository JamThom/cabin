{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/api/*": ["src/api/*"],
      "@/ui/*": ["src/ui/*"],
      "@/routes/*": ["src/routes/*"],
      "@/store/*": ["src/store/*"],
      "@/utils/*": ["src/utils/*"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": ["src"]
}
